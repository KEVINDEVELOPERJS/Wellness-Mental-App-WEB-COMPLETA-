// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USUARIO
  PSICOLOGO
  PADRE
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  PENDIENTE
  SUSPENDIDO
}

enum EstadoAlerta {
  PENDIENTE
  ATENDIDA
  EN_SEGUIMIENTO
  DERIVADA
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

enum EstadoInforme {
  GENERADO
  ENVIADO
  LEIDO
}

enum EstadoModeracion {
  APROBADO
  PENDIENTE
  RECHAZADO
}

enum TipoEjercicio {
  RESPIRACION
  MEDITACION
  RELAJACION
}

model Usuario {
  id                Int         @id @default(autoincrement())
  nombre            String
  email             String      @unique
  passwordHash      String
  edad              Int
  grado            String
  rol               Rol         @default(USUARIO)
  fechaRegistro     DateTime    @default(now())
  estado            EstadoUsuario @default(ACTIVO)
  consentimientoPadres Boolean  @default(false)
  codigoInvitacionPadre String? @unique
  avatar            String?
  telefono         String?

  // Relaciones
  respuestas        Respuesta[]
  resultados        Resultado[]
  chatSessions      ChatSession[]
  ejerciciosProgreso ProgresoEjercicio[]
  posts             PostComunidad[]
  comentarios       Comentario[]
  logros            UsuarioLogro[]
  alertas           AlertaRiesgo[]
  informesRecibidos Informe[]      @relation("PadreInformes")
  informesGenerados Informe[]      @relation("PsicologoInformes")
  sesionesActivas   SesionActiva[]
  preferencias      PreferenciasUsuario?
  
  @@index([email])
  @@index([rol])
  @@index([estado])
}

model Cuestionario {
  id                Int         @id @default(autoincrement())
  titulo            String
  descripcion       String
  instrucciones     String
  categoria         String
  estado            String      @default("publicado") // borrador, publicado
  fechaCreacion     DateTime    @default(now())
  
  preguntas         Pregunta[]
  resultados        Resultado[]
  
  @@index([estado])
  @@index([categoria])
}

model Pregunta {
  id                Int         @id @default(autoincrement())
  cuestionarioId    Int
  cuestionario      Cuestionario @relation(fields: [cuestionarioId], references: [id], onDelete: Cascade)
  texto             String
  tipoRespuesta     String      @default("likert") // likert, opcion_multiple, texto
  peso              Float       @default(1.0)
  orden             Int
  opciones          String?     // JSON array para opciones múltiples
  
  respuestas        Respuesta[]
  
  @@index([cuestionarioId])
}

model Respuesta {
  id                Int         @id @default(autoincrement())
  preguntaId        Int
  pregunta          Pregunta    @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  valor             Int
  texto             String?
  fechaRespuesta    DateTime    @default(now())
  
  @@index([preguntaId])
  @@index([usuarioId])
}

model Resultado {
  id                Int         @id @default(autoincrement())
  cuestionarioId    Int
  cuestionario      Cuestionario @relation(fields: [cuestionarioId], references: [id])
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  puntaje           Int
  nivelRiesgo       NivelRiesgo
  prediagnostico    String
  fechaEvaluacion   DateTime    @default(now())
  
  informes          Informe[]
  alertas           AlertaRiesgo[]
  
  @@index([usuarioId])
  @@index([nivelRiesgo])
  @@index([fechaEvaluacion])
}

model ChatSession {
  id                Int         @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  fechaInicio       DateTime    @default(now())
  fechaUltimoMensaje DateTime?
  activa            Boolean     @default(true)
  
  mensajes          MensajeChat[]
  alertas           AlertaRiesgo[]
  
  @@index([usuarioId])
  @@index([activa])
}

model MensajeChat {
  id                Int         @id @default(autoincrement())
  chatSessionId     Int
  chatSession       ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  remitente         String      // "usuario" o "ia"
  contenido         String
  sentimiento       Float?      // 0.0 - 1.0
  fechaMensaje      DateTime    @default(now())
  
  @@index([chatSessionId])
  @@index([fechaMensaje])
}

model Ejercicio {
  id                Int         @id @default(autoincrement())
  titulo            String
  descripcion       String
  tipo              TipoEjercicio
  duracionMinima    Int         @default(3)
  duracionMaxima    Int         @default(10)
  instrucciones     String
  audioUrl          String?
  imagenUrl         String?
  
  progresos         ProgresoEjercicio[]
  
  @@index([tipo])
}

model ProgresoEjercicio {
  id                Int         @id @default(autoincrement())
  ejercicioId       Int
  ejercicio         Ejercicio   @relation(fields: [ejercicioId], references: [id])
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  duracionReal      Int
  completado        Boolean     @default(false)
  satisfaccion      Int         @default(0) // 1-5 estrellas
  fechaCompletado   DateTime    @default(now())
  
  @@index([usuarioId])
  @@index([ejercicioId])
  @@index([fechaCompletado])
}

model PostComunidad {
  id                Int         @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  titulo            String
  contenido         String
  categoria         String
  fecha             DateTime    @default(now())
  estadoModeracion  EstadoModeracion @default(APROBADO)
  likes             Int         @default(0)
  reportado         Boolean     @default(false)
  reportadoCount    Int         @default(0)
  
  comentarios       Comentario[]
  
  @@index([usuarioId])
  @@index([categoria])
  @@index([estadoModeracion])
  @@index([fecha])
}

model Comentario {
  id                Int         @id @default(autoincrement())
  postId            Int
  post              PostComunidad @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  contenido         String
  fecha             DateTime    @default(now())
  parentId          Int?

  @@index([postId])
  @@index([usuarioId])
}

model Logro {
  id                Int         @id @default(autoincrement())
  nombre            String
  descripcion       String
  puntos            Int
  criterio          String      // JSON con criterios de desbloqueo
  icono             String?
  
  usuarios          UsuarioLogro[]
  
  @@index([puntos])
}

model UsuarioLogro {
  id                Int         @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  logroId           Int
  logro             Logro       @relation(fields: [logroId], references: [id])
  fechaDesbloqueado DateTime    @default(now())
  
  @@unique([usuarioId, logroId])
  @@index([usuarioId])
  @@index([logroId])
}

model AlertaRiesgo {
  id                Int         @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  tipo              String      // "evaluacion", "chat", "manual"
  nivelRiesgo       NivelRiesgo
  timestamp         DateTime    @default(now())
  extracto          String
  estado            EstadoAlerta @default(PENDIENTE)
  notas             String?
  resultadoId       Int?
  resultado         Resultado?  @relation(fields: [resultadoId], references: [id])
  chatSessionId     Int?
  chatSession       ChatSession? @relation(fields: [chatSessionId], references: [id])
  ipOrigen          String?
  userAgent         String?
  
  auditoria         AuditoriaAlerta[]
  
  @@index([usuarioId])
  @@index([estado])
  @@index([timestamp])
  @@index([nivelRiesgo])
}

model AuditoriaAlerta {
  id                Int         @id @default(autoincrement())
  alertaId          Int
  alerta            AlertaRiesgo @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  accion            String
  timestamp         DateTime    @default(now())
  ip                String?
  userAgent         String?
  detalles          String?
  
  @@index([alertaId])
  @@index([timestamp])
}

model Informe {
  id                Int         @id @default(autoincrement())
  resultadoId       Int
  resultado         Resultado   @relation(fields: [resultadoId], references: [id])
  padreId           Int?
  padre             Usuario?    @relation("PadreInformes", fields: [padreId], references: [id])
  psicologoId       Int?
  psicologo         Usuario?    @relation("PsicologoInformes", fields: [psicologoId], references: [id])
  resumen           String
  detalle           String
  recomendaciones   String
  nivelRiesgo       NivelRiesgo
  fechaEnvio        DateTime    @default(now())
  estadoLectura     EstadoInforme @default(GENERADO)
  hashSeguridad     String      @unique
  tokenAcceso       String      @unique
  expiracionToken   DateTime?
  
  @@index([padreId])
  @@index([resultadoId])
  @@index([estadoLectura])
}

model SesionActiva {
  id                Int         @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  token             String      @unique
  refreshToken      String?
  ip                String
  userAgent         String
  fechaInicio       DateTime    @default(now())
  fechaUltimaActividad DateTime  @default(now())
  
  @@index([usuarioId])
  @@index([token])
}

model PreferenciasUsuario {
  id                Int         @id @default(autoincrement())
  usuarioId         Int         @unique
  usuario           Usuario     @relation(fields: [usuarioId], references: [id])
  notificacionesChat Boolean    @default(true)
  notificacionesEjercicios Boolean @default(true)
  notificacionesComunidad Boolean @default(true)
  notificacionesAlertas Boolean  @default(true)
  horaRecordatorio   String?     @default("09:00")
  temaOscuro         Boolean     @default(false)
  idioma            String      @default("es")
  
  @@index([usuarioId])
}
