# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/wellness_mental?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"

# Server
PORT=3001
NODE_ENV="development"

# Email (Optional - if not configured, email features will be disabled gracefully)
# For Gmail: Use an App Password (https://support.google.com/accounts/answer/185833)
# For SendGrid: Use smtp.sendgrid.net with port 587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@wellness.com"

# Web Push
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:your-email@example.com"

# OpenAI (for AI chat) - DEPRECATED: Use GEMINI instead
OPENAI_API_KEY="your-openai-api-key"

# Gemini AI (for AI chat) - REQUIRED
# To get your API key:
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Create a new project or select existing one
# 3. Generate an API key
# 4. Copy the key and paste it below
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# CORS
CORS_ORIGIN="https://wellness-mental-app-web-completa.vercel.app"
